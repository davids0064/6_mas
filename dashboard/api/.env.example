# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

# --- Base de datos -----------------------------------------------------------
# El usuario es seis_dashboard, NO el superusuario: ese rol tiene permisos
# solo sobre el contexto comercio y no puede leer la tabla `usuarios`
# (ver db/migrations/001_dashboard_comercios.sql).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seis_mas
DB_USER=seis_dashboard
DB_PASSWORD=dashboard_local_dev
# local: prefer | Railway y Postgres gestionados: require
DB_SSLMODE=prefer

# --- JWT ---------------------------------------------------------------------
# Genera uno propio con:  php -r "echo bin2hex(random_bytes(32));"
# Si falta, la API se niega a arrancar en vez de firmar con un secreto conocido.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_TTL_SEGUNDOS=28800
JWT_ISSUER=seis-mas-dashboard

# --- CORS --------------------------------------------------------------------
# Orígenes autorizados separados por coma. Nunca uses '*'.
# En producción: https://tudominio.com
CORS_ORIGENES=http://localhost:4200

# --- App ---------------------------------------------------------------------
# true solo en desarrollo: expone el mensaje real de los errores 500.
APP_DEBUG=true
