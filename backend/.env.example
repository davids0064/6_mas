# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=3000

# Conexión a PostgreSQL. En desarrollo local con Postgres.app/Homebrew,
# DATABASE_URL suele bastar; en producción usa las variables separadas si tu
# proveedor no expone una URL única.
DATABASE_URL=postgres://usuario:password@localhost:5432/seis_mas

# Número de rondas de bcrypt. 10-12 es razonable para el MVP.
BCRYPT_SALT_ROUNDS=10
