# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=3000

# --- Base de datos -----------------------------------------------------------
# En producción el usuario debe ser `seis_app`, NO el superusuario: ese rol no
# tiene ningún permiso sobre las tablas del contexto comercio (ver
# db/migrations/001_dashboard_comercios.sql), así que la frontera entre los dos
# mundos la sostiene Postgres y no el código de esta API.
DATABASE_URL=postgres://seis_app:app_local_dev@localhost:5432/seis_mas

# --- Sesión de usuario -------------------------------------------------------
# Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable el backend se niega a arrancar, en vez de firmar tokens con
# un secreto vacío que cualquiera podría replicar.
#
# Debe ser DISTINTO al JWT_SECRET del dashboard: un token de usuario no tiene
# por qué abrir el panel de un comercio.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_TTL_SEGUNDOS=2592000
JWT_ISSUER=seis-mas-app

# --- Administración ----------------------------------------------------------
# Clave para las rutas de operación: correr el matching, editar los catálogos
# paramétricos, dar de alta comercios. Se manda en la cabecera X-Admin-Key.
# Si se deja vacía, esas rutas responden 503 y quedan cerradas — que es el
# comportamiento seguro para un despliegue que no las necesita.
ADMIN_API_KEY=

# --- CORS --------------------------------------------------------------------
# Orígenes de navegador autorizados, separados por coma. Nunca '*'.
# No afecta a la app móvil (fetch nativo no aplica CORS); esto es para clientes
# web. Vacío = ningún origen de navegador permitido.
CORS_ORIGENES=

# --- Contraseñas -------------------------------------------------------------
# Número de rondas de bcrypt. 10-12 es razonable para el MVP.
BCRYPT_SALT_ROUNDS=10
